# Token do @BotFather
TELEGRAM_TOKEN=
# O teu chat id (envia /id ao bot para o descobrir); todas as outras contas são ignoradas
ALLOWED_CHAT_ID=
DB_PATH=kaidokubot.db
# Avaliação por IA (usa o Claude CLI com sessão iniciada); CLAUDE_BIN só é preciso se o claude não estiver no PATH
CLAUDE_BIN=
CLAUDE_MODEL=sonnet
# Máximo de avaliações por IA por dia (o dia vira à meia-noite de Tóquio); 0 desliga a avaliação
MAX_AVALIACOES_DIA=30
# Quanto mais barato que na Europa (%) tem de ser para o veredicto ser "compensa"
MARGEM_MINIMA=20
# Durante quantos dias uma avaliação é reutilizada para o mesmo artigo e estado
CACHE_DIAS=30
